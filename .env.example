# Fintel Secure environment template
# Copy this file to .env and fill in your real values.

PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/fintel_secure

# Use a long random secret in real deployments
JWT_SECRET=replace-with-a-long-random-secret

JWT_EXPIRES_IN=1d

# Vite runs on 127.0.0.1:5174 in this project
CLIENT_ORIGIN=http://127.0.0.1:5174

# Optional
MAX_UPLOAD_SIZE_BYTES=5242880
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Fintel Secure Admin

# Optional Vite proxy override
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000
